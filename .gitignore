# Secrets
.env

# Python
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# macOS
.DS_Store

# Regenerated by scripts
data/processed/*
!data/processed/.gitkeep

# Yahoo Finance prices: not redistributed, re-download with src/fetch_markets.py
data/raw/markets/

# UN Comtrade raw JSON: redistribution terms not checked, re-download with src/fetch_comtrade.py
data/raw/comtrade/

# KCS press release attachments (~50 MB): re-download with src/extract_kcs_first20.py
data/raw/kcs_releases/

# OpenDART raw API answers: re-download with src/fetch_earnings.py (needs DART_API_KEY)
data/raw/dart/

# R session files
.Rhistory
.RData

# Intermediate HTML of the PDF build (regenerated by src/build_pdf.py)
paper/chip_canary_note.html
